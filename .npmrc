# The dev container's node_modules lives in a named Docker volume that can
# fall out of sync with pnpm-lock.yaml. pnpm then wants to interactively
# confirm purging it before reinstalling — but a detached container has no
# TTY, so it aborts instead of prompting (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY).
# Disabling the confirmation lets it purge and reinstall automatically.
confirmModulesPurge=false
